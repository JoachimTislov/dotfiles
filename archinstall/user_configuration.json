{
  "archinstall-language": "English",
  "audio_config": {
    "audio": "pipewire"
  },
  "bootloader_config": {
    "bootloader": "Systemd-boot",
    "uki": false,
    "removable": false
  },
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "/dev/nvme0n1",
        "partitions": [
          {
            "btrfs": [],
            "dev_path": null,
            "flags": ["boot"],
            "fs_type": "fat32",
            "size": {"unit": "MiB", "value": 512},
            "mount_options": [],
            "mountpoint": "/boot",
            "obj_id": "11111111-1111-4111-8111-111111111111",
            "start": {"unit": "MiB", "value": 1},
            "status": "create",
            "type": "primary"
          },
          {
            "btrfs": [
              {"name": "@", "mountpoint": "/"},
              {"name": "@home", "mountpoint": "/home"},
              {"name": "@log", "mountpoint": "/var/log"},
              {"name": "@cache", "mountpoint": "/var/cache"},
              {"name": "@snapshots", "mountpoint": "/.snapshots"}
            ],
            "dev_path": null,
            "flags": [],
            "fs_type": "btrfs",
            "size": {"unit": "B", "value": 0},
            "mount_options": ["compress=zstd", "noatime"],
            "mountpoint": "/",
            "obj_id": "22222222-2222-4222-8222-222222222222",
            "start": {"unit": "MiB", "value": 513},
            "status": "create",
            "type": "primary"
          }
        ],
        "wipe": true
      }
    ],
    "disk_encryption": {
      "encryption_type": "luks",
      "partitions": ["22222222-2222-4222-8222-222222222222"]
    }
  },
  "hostname": "archlinux",
  "kernels": ["linux"],
  "locale_config": {
    "kb_layout": "no",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "network_config": {"type": "nm"},
  "ntp": true,
  "packages": ["btrfs-progs", "snapper", "snap-pac"],
  "profile_config": {
    "gfx_driver": "All open-source",
    "greeter": "sddm",
    "profile": {"main": "Minimal", "details": []}
  },
  "script": "guided",
  "swap": {"enabled": true, "algorithm": "zstd"},
  "timezone": "Europe/Oslo",
  "version": "2.8.6"
}
